APP_NAME=ShopLedger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:4200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopledger
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=shopledger
JWT_AUDIENCE=shopledger.client

# Browser + Capacitor WebView origins (comma-separated). Website cookies need an exact origin.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost,https://localhost,capacitor://localhost,ionic://localhost

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

SHOPLEDGER_TRIAL_DAYS=10
SHOPLEDGER_LIFETIME_INR=150
SHOPLEDGER_UPI_ID=rohitsbhaira@okhdfcbank
SHOPLEDGER_WHATSAPP=7385179434

# Optional first-admin seeder only. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Phase 5 data copy only (read-only Postgres snapshot). Never point this at production writes.
# Example: pgsql://readonly_user:secret@127.0.0.1:5432/shopledger_snapshot
PG_SOURCE_URL=
PG_ATTACHMENTS_PATH=
